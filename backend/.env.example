# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# OpenAI Configuration
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/company_brain

# Vector Store Configuration
VECTOR_STORE_TYPE=pinecone
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=company-brain

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Environment
ENVIRONMENT=development
DEBUG=True

# Cursor Bridge
CURSOR_BRIDGE_BACKEND=mock
CURSOR_BRIDGE_API_KEY=sk-curbr-local-dev
CURSOR_BRIDGE_PUBLIC_URL=http://127.0.0.1:8000/api/cursor-bridge
CURSOR_BRIDGE_MODELS=cursor-fast,composer-2.5
CURSOR_MCP_COMMAND=npx
CURSOR_MCP_ARGS=-y,cursor-bridge-mcp
